{
  "name": "mcu-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "next lint && tsc --noEmit && node scripts/check-data.mjs && node scripts/check-i18n.mjs",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "node scripts/build.mjs && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "posters": "node scripts/fetch-posters.mjs",
    "posters:optimize": "node scripts/optimize-posters.mjs",
    "metadata": "node scripts/fetch-metadata.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "data:check": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.3",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.0.9"
}
